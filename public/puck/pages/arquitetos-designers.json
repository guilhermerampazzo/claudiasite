{"content": [{"type": "Secao", "props": {"id": "arquitetos-designers-sec-1", "rotulo": "hero", "html": "<section class=\"hero\" style=\"background-image: url(&quot;/uploads/capas/arquiteto-design.jpg?v=20260921&quot;); background-size: cover; background-position: center center; background-repeat: no-repeat;\">\n  <div class=\"hero-bg-word\">ARQUITETOS</div>\n\n  <div class=\"hero-left\">\n    <div class=\"hero-label\">Programa de Relacionamento Casa Estampa</div>\n    <h1 class=\"hero-title\">Arquitetos &amp; Designers</h1>\n    <p class=\"hero-title-line2\"></p>\n    <p class=\"hero-quote\">\"Grandes projetos nascem de grandes parcerias.\"</p>\n    <p class=\"hero-sub\" style=\"font-size: 16px; color: rgb(234, 209, 169);\">Atendimento personalizado, produtos exclusivos e suporte completo para arquitetos e designers de interiores.</p>\n    <div class=\"hero-ctas\">\n      <a href=\"#cadastro\" class=\"btn-mustard\">Quero ser parceiro</a>\n      <a href=\"#beneficios\" class=\"btn-ghost\">Ver benefícios</a>\n    </div>\n  </div>\n</section>\n\n\n<!-- ══ QUEM SOMOS ══ -->\n"}}, {"type": "Secao", "props": {"id": "arquitetos-designers-sec-2", "rotulo": "quem-somos", "html": "<section class=\"quem-somos\">\n  <div class=\"eyebrow\" style=\"font-size: 14px;\">Nossa proposta</div>\n  <div class=\"quem-somos-inner\">\n    <div class=\"quem-left\">\n      <h2 class=\"block-title\">Seu projeto,<br>nossa <em>prioridade</em></h2>\n      <div class=\"rule\"></div>\n    </div>\n    <div class=\"quem-text\">\n      <p style=\"color: rgb(234, 209, 169);\">Na Casa Estampa, entendemos que cada projeto é único. Por isso, oferecemos <strong>suporte completo</strong> aos arquitetos e designers de interiores, proporcionando agilidade, atendimento personalizado e acompanhamento técnico em todas as etapas.</p>\n      <p style=\"color: rgb(234, 209, 169);\">Nosso objetivo é <strong>transformar especificações em experiências</strong>, garantindo qualidade, sofisticação e excelência na entrega de cada projeto.</p>\n    </div>\n  </div>\n  <a href=\"https://api.whatsapp.com/send?phone=5521999886842&amp;text=Olá! Gostaria de conhecer o Programa de Parceria Casa Estampa para arquitetos.\" class=\"btn-mustard\" style=\"font-size:10px;padding:14px 28px;\">Falar com consultor</a>\n</section>\n\n\n<!-- ══ BENEFÍCIOS ══ -->\n"}}, {"type": "Secao", "props": {"id": "arquitetos-designers-sec-3", "rotulo": "beneficios", "html": "<section class=\"beneficios\" id=\"beneficios\">\n  <div class=\"eyebrow\" style=\"font-size: 14px;\">Exclusivo para parceiros</div>\n  <h2 class=\"block-title\">Benefícios que fazem a <em>diferença</em></h2>\n  <p class=\"block-sub\" style=\"font-size: 16px; color: rgb(234, 209, 169);\">Tudo o que você precisa para especificar com confiança e entregar com excelência.</p>\n  <div class=\"rule\"></div>\n\n  <div class=\"ben-grid\">\n    <div class=\"ben-card\">\n      <i class=\"ben-icon ti ti-truck-delivery\" aria-hidden=\"true\"></i>\n      <div class=\"ben-title\" style=\"font-weight: 700; font-size: 18px;\">Mostruários até o escritório ou obra</div>\n      <p class=\"ben-desc\" style=\"color: rgb(234, 209, 169); font-size: 13px;\">Levamos as amostras até você, sem precisar se deslocar.</p>\n    </div>\n    <div class=\"ben-card\">\n      <i class=\"ben-icon ti ti-file-invoice\" aria-hidden=\"true\"></i>\n      <div class=\"ben-title\" style=\"font-size: 18px;\">Orçamentos rápidos e personalizados</div>\n      <p class=\"ben-desc\" style=\"color: rgb(234, 209, 169); font-size: 13px;\">Respostas ágeis e propostas adaptadas a cada projeto.</p>\n    </div>\n    <div class=\"ben-card\">\n      <i class=\"ben-icon ti ti-ruler-measure\" aria-hidden=\"true\"></i>\n      <div class=\"ben-title\" style=\"font-size: 18px;\">Visita técnica e medição especializada</div>\n      <p class=\"ben-desc\" style=\"color: rgb(234, 209, 169); font-size: 13px;\">Nossa equipe vai até o local para garantir precisão na especificação.</p>\n    </div>\n    <div class=\"ben-card\">\n      <i class=\"ben-icon ti ti-route\" aria-hidden=\"true\"></i>\n      <div class=\"ben-title\" style=\"font-size: 18px;\">Acompanhamento da especificação à instalação</div>\n      <p class=\"ben-desc\" style=\"color: rgb(234, 209, 169); font-size: 13px;\">Suporte completo em todas as etapas do seu projeto.</p>\n    </div>\n    <div class=\"ben-card\">\n      <i class=\"ben-icon ti ti-tool\" aria-hidden=\"true\"></i>\n      <div class=\"ben-title\" style=\"font-size: 18px;\">Equipe própria e especializada de instalação</div>\n      <p class=\"ben-desc\" style=\"color: rgb(234, 209, 169); font-size: 13px;\">Instalação feita por profissionais treinados, sem terceirizações.</p>\n    </div>\n    <div class=\"ben-card\">\n      <i class=\"ben-icon ti ti-package\" aria-hidden=\"true\"></i>\n      <div class=\"ben-title\" style=\"font-size: 18px;\">Produtos exclusivos, nacionais e importados</div>\n      <p class=\"ben-desc\" style=\"color: rgb(234, 209, 169); font-size: 13px;\">Curadoria especial com linhas que não estão disponíveis para o público geral.</p>\n    </div>\n    <div class=\"ben-card\">\n      <i class=\"ben-icon ti ti-star\" aria-hidden=\"true\"></i>\n      <div class=\"ben-title\" style=\"font-size: 18px;\">Atendimento prioritário</div>\n      <p class=\"ben-desc\" style=\"color: rgb(234, 209, 169); font-size: 13px;\">Profissionais parceiros têm prioridade no atendimento e nas entregas.</p>\n    </div>\n    <div class=\"ben-card\">\n      <i class=\"ben-icon ti ti-discount\" aria-hidden=\"true\"></i>\n      <div class=\"ben-title\" style=\"font-size: 18px;\">Condições comerciais diferenciadas</div>\n      <p class=\"ben-desc\" style=\"color: rgb(234, 209, 169); font-size: 13px;\">Tabela exclusiva e condições especiais para parceiros do programa.</p>\n    </div>\n  </div>\n</section>\n\n\n<!-- ══ CLUBE DE BENEFÍCIOS ══ -->\n"}}, {"type": "Secao", "props": {"id": "arquitetos-designers-sec-4", "rotulo": "clube", "html": "<section class=\"clube\">\n  <div class=\"clube-left\">\n    <div class=\"eyebrow\" style=\"font-size: 14px;\">Programa exclusivo</div>\n    <h2 class=\"block-title\">Clube de Benefícios<br><em>Casa Estampa</em></h2>\n    <div class=\"rule\"></div>\n    <p class=\"clube-desc\" style=\"color: rgb(234, 209, 169);\">Reconhecemos e valorizamos nossos parceiros através de um programa exclusivo de relacionamento, com benefícios comerciais diferenciados, campanhas de incentivo e premiações especiais conforme o volume de projetos realizados.</p>\n  </div>\n  <div class=\"clube-right\">\n    <div class=\"clube-item\">\n      <div class=\"clube-item-icon\"><i class=\"ti ti-gift\" aria-hidden=\"true\"></i></div>\n      <div class=\"clube-item-title\">Vouchers gastronômicos</div>\n    </div>\n    <div class=\"clube-item\">\n      <div class=\"clube-item-icon\"><i class=\"ti ti-shopping-bag\" aria-hidden=\"true\"></i></div>\n      <div class=\"clube-item-title\">Vale-compras exclusivos</div>\n    </div>\n    <div class=\"clube-item\">\n      <div class=\"clube-item-icon\"><i class=\"ti ti-rocket\" aria-hidden=\"true\"></i></div>\n      <div class=\"clube-item-title\">Campanhas de incentivo</div>\n    </div>\n    <div class=\"clube-item\">\n      <div class=\"clube-item-icon\"><i class=\"ti ti-award\" aria-hidden=\"true\"></i></div>\n      <div class=\"clube-item-title\">Premiações especiais</div>\n    </div>\n    <div class=\"clube-item\">\n      <div class=\"clube-item-icon\"><i class=\"ti ti-calendar-event\" aria-hidden=\"true\"></i></div>\n      <div class=\"clube-item-title\">Eventos e lançamentos</div>\n    </div>\n    <div class=\"clube-item\">\n      <div class=\"clube-item-icon\"><i class=\"ti ti-school\" aria-hidden=\"true\"></i></div>\n      <div class=\"clube-item-title\">Treinamentos e atualizações</div>\n    </div>\n  </div>\n</section>\n\n\n<!-- ══ PORTFÓLIO ══ -->\n"}}, {"type": "Secao", "props": {"id": "arquitetos-designers-sec-5", "rotulo": "portfolio", "html": "<section class=\"portfolio\">\n  <div class=\"eyebrow\" style=\"font-size: 14px;\">Portfólio</div>\n  <h2 class=\"block-title\">Obras que <em>inspiram</em></h2>\n  <p class=\"block-sub\" style=\"font-size: 16px; color: rgb(234, 209, 169);\">Projetos de arquitetos parceiros.</p>\n  <div class=\"rule\"></div>\n\n  <div class=\"vid-grid\">\n\n    <div class=\"vid-card\">\n      <!-- <video preload=\"metadata\" src=\"video-flavio.mp4\" controls></video> -->\n      <div class=\"vid-placeholder\">\n        \n        \n      </div>\n      <div class=\"vid-info\">\n        <div class=\"vid-projeto\">Projeto Flavio</div>\n        <div class=\"vid-arq\">Arquiteta Patricia Machado</div>\n      </div>\n    </div>\n\n    <div class=\"vid-card\">\n      <!-- <video preload=\"metadata\" src=\"video-servi-promo.mp4\" controls></video> -->\n      <div class=\"vid-placeholder\" style=\"overflow: hidden;\"><div data-ce-bg-video=\"arquivo\" style=\"position: absolute; inset: 0px; overflow: hidden; pointer-events: none; z-index: 0;\"><video preload=\"metadata\" src=\"/uploads/2026-07-29/1785286898736-whatsapp-video-2026-07-28-at-12.48.07.mp4\" autoplay=\"\" muted=\"\" loop=\"\" playsinline=\"\" style=\"width: 100%; height: 100%; object-fit: cover; display: block;\"></video></div>\n        \n        \n      </div>\n      <div class=\"vid-info\">\n        <div class=\"vid-projeto\">Projeto Servi Promo</div>\n        <div class=\"vid-arq\">Arquiteta Suellen Soares</div>\n      </div>\n    </div>\n\n    <div class=\"vid-card\">\n      <!-- <video preload=\"metadata\" src=\"video-liana.mp4\" controls></video> -->\n      <div class=\"vid-placeholder\">\n        \n        \n      </div>\n      <div class=\"vid-info\">\n        <div class=\"vid-projeto\">Projeto</div>\n        <div class=\"vid-arq\">Arquiteta Liana Figueirinha</div>\n      </div>\n    </div>\n\n    <div class=\"vid-card\">\n      <!-- <video preload=\"metadata\" src=\"video-taciana.mp4\" controls></video> -->\n      <div class=\"vid-placeholder\">\n        \n        \n      </div>\n      <div class=\"vid-info\">\n        <div class=\"vid-projeto\">Projeto</div>\n        <div class=\"vid-arq\">Arquiteta Taciana Lessa</div>\n      </div>\n    </div>\n\n  </div>\n</section>\n\n\n<!-- ══ MOSTRA MORAR MAIS ══ -->\n"}}, {"type": "Secao", "props": {"id": "arquitetos-designers-sec-6", "rotulo": "mostra", "html": "<section class=\"mostra\">\n  <div class=\"mostra-head\" style=\"display:flex;flex-wrap:wrap;align-items:center;gap:24px;margin-bottom:24px;\">\n    <img src=\"/assets/morar-mais-logo.png\" alt=\"Morar Mais — o chique que cabe no bolso\" style=\"height:96px;width:auto;object-fit:contain;\">\n    <div style=\"flex:1;min-width:260px;\">\n      <div class=\"eyebrow\" style=\"font-size: 14px;\">Presença e Reconhecimento</div>\n      <h2 class=\"block-title\">Mostra Morar Mais <em>2025</em></h2>\n    </div>\n  </div>\n  <div class=\"rule\"></div>\n\n  <div class=\"mostra-intro\">\n    <div>\n      <div class=\"mostra-texto\">\n        <p style=\"color: rgb(234, 209, 169);\">Em 2025, a Casa Estampa foi <strong>fornecedora oficial</strong> da Mostra Morar Mais, um dos maiores eventos de decoração e design de interiores do Rio de Janeiro.</p>\n        <p style=\"color: rgb(234, 209, 169);\">Montamos uma loja exclusiva dentro da Mostra, onde apresentamos nossa coleção de <strong>papéis de parede a pronta entrega</strong>, persianas, cortinas e revestimentos;  permitindo que arquitetos, designers e o público geral experimentassem de perto o universo Casa Estampa.</p>\n        <p style=\"color: rgb(234, 209, 169);\">Uma oportunidade única de conectar nossos produtos diretamente com profissionais e clientes que buscam o melhor em decoração de alto padrão.</p>\n      </div>\n    </div>\n    <div class=\"mostra-badge\">\n      <div class=\"mostra-badge-ano\" style=\"font-size: 50px; font-weight: 600;\">Fornecedora oficial</div>\n      <div class=\"mostra-badge-titulo\">2025</div>\n      <div class=\"mostra-badge-sub\">Mostra Morar Mais · Rio de Janeiro</div>\n      <div class=\"mostra-badge-desc\" style=\"color: rgb(234, 209, 169);\">Papéis de parede a pronta entrega · Persianas · Cortinas · Revestimentos exclusivos</div>\n    </div>\n  </div>\n\n  <div class=\"mostra-fotos\">\n    <div class=\"mostra-foto wide\">\n      <!-- <img src=\"morar-mais-1.jpg\" alt=\"Loja Casa Estampa na Mostra Morar Mais 2025\" /> -->\n      <div class=\"mostra-foto-ph\" style=\"background-image: url(&quot;/uploads/2026-07-29/1785286962376-whatsapp-image-2026-07-28-at-12.56.34--5-.jpeg&quot;); background-size: cover; background-position: center center; background-repeat: no-repeat;\"><i class=\"ti ti-photo\" aria-hidden=\"true\"></i><span>Inserir foto</span></div>\n    </div>\n    <div class=\"mostra-foto\">\n      <!-- <img src=\"morar-mais-2.jpg\" alt=\"\" /> -->\n      <div class=\"mostra-foto-ph\" style=\"background-image: url(&quot;/uploads/2026-07-29/1785286978896-whatsapp-image-2026-07-28-at-12.56.34--3-.jpeg&quot;); background-size: cover; background-position: center center; background-repeat: no-repeat;\"></div>\n    </div>\n    <div class=\"mostra-foto\">\n      <!-- <img src=\"morar-mais-3.jpg\" alt=\"\" /> -->\n      <div class=\"mostra-foto-ph\" style=\"background-image: url(&quot;/uploads/2026-07-29/1785286989699-whatsapp-image-2026-07-28-at-12.56.34.jpeg&quot;); background-size: cover; background-position: center center; background-repeat: no-repeat;\"></div>\n    </div>\n    <div class=\"mostra-foto\">\n      <!-- <img src=\"morar-mais-4.jpg\" alt=\"\" /> -->\n      <div class=\"mostra-foto-ph\" style=\"background-image: url(&quot;/uploads/2026-07-29/1785286999850-whatsapp-image-2026-07-28-at-12.56.35.jpeg&quot;); background-size: cover; background-position: center center; background-repeat: no-repeat;\"></div>\n    </div>\n    <div class=\"mostra-foto\">\n      <!-- <img src=\"morar-mais-5.jpg\" alt=\"\" /> -->\n      <div class=\"mostra-foto-ph\" style=\"background-image: url(&quot;/uploads/2026-07-29/1785287028281-whatsapp-image-2026-07-28-at-12.56.35--4-.jpeg&quot;); background-size: cover; background-position: center center; background-repeat: no-repeat;\"></div>\n    </div>\n    <div class=\"mostra-foto wide\">\n      <!-- <img src=\"morar-mais-6.jpg\" alt=\"\" /> -->\n      <div class=\"mostra-foto-ph\" style=\"background-image: url(&quot;/uploads/2026-07-29/1785287043593-whatsapp-image-2026-07-28-at-12.56.34--4-.jpeg&quot;); background-size: cover; background-position: center bottom; background-repeat: no-repeat;\"><i class=\"ti ti-photo\" aria-hidden=\"true\"></i><span>Inserir foto</span></div>\n        <div class=\"mostra-foto\">\n      <!-- <img src=\"morar-mais-7.jpg\" alt=\"\" /> -->\n      <div class=\"mostra-foto-ph\" style=\"background-image: url(&quot;/uploads/2026-07-29/1785288498144-whatsapp-image-2026-07-28-at-12.56.35--1-.jpeg&quot;); background-size: cover; background-position: center center; background-repeat: no-repeat;\"><i class=\"ti ti-photo\" aria-hidden=\"true\"></i><span>Inserir foto</span></div>\n    </div>\n    <div class=\"mostra-foto\">\n      <!-- <img src=\"morar-mais-8.jpg\" alt=\"\" /> -->\n      <div class=\"mostra-foto-ph\" style=\"background-image: url(&quot;/uploads/2026-07-29/1785288706407-whatsapp-image-2026-07-28-at-22.29.28.jpeg&quot;); background-size: cover; background-position: center center; background-repeat: no-repeat;\"><i class=\"ti ti-photo\" aria-hidden=\"true\"></i><span>Inserir foto</span></div>\n    </div>\n    <div class=\"mostra-foto wide\">\n      <!-- <img src=\"morar-mais-9.jpg\" alt=\"\" /> -->\n      <div class=\"mostra-foto-ph\" style=\"background-image: url(&quot;/uploads/2026-07-29/1785288888274-whatsapp-image-2026-07-28-at-22.34.25.jpeg&quot;); background-size: cover; background-position: center center; background-repeat: no-repeat;\"><i class=\"ti ti-photo\" aria-hidden=\"true\"></i><span>Inserir foto</span></div>\n    <div class=\"mostra-foto\"><div class=\"mostra-foto-ph\"><i class=\"ti ti-photo\" aria-hidden=\"true\"></i><span>Inserir foto</span></div></div>\n    <div class=\"mostra-foto\"><div class=\"mostra-foto-ph\"><i class=\"ti ti-photo\" aria-hidden=\"true\"></i><span>Inserir foto</span></div></div>\n    <div class=\"mostra-foto\"><div class=\"mostra-foto-ph\"><i class=\"ti ti-photo\" aria-hidden=\"true\"></i><span>Inserir foto</span></div></div>\n    </div>\n  </div>\n</div></section>\n\n\n<!-- ══ FORMULÁRIO ══ -->\n"}}, {"type": "Secao", "props": {"id": "arquitetos-designers-sec-7", "rotulo": "cadastro", "html": "<section class=\"cadastro\" id=\"cadastro\">\n  <div class=\"cadastro-left\">\n    <div class=\"eyebrow\" style=\"font-size: 14px;\">Faça parte</div>\n    <h2 class=\"block-title\">Cadastre-se como <em>parceiro</em></h2>\n    <div class=\"rule\"></div>\n    <p class=\"block-sub\" style=\"margin-top: 20px; font-size: 16px; color: rgb(234, 209, 169);\">Preencha o formulário e nossa equipe entrará em contato para apresentar todas as condições exclusivas do programa.</p>\n  </div>\n\n  <form class=\"form-grid\">\n    <div class=\"form-field\">\n      <label class=\"form-label\">Nome completo</label>\n      <input type=\"text\" class=\"form-input\" placeholder=\"Seu nome\">\n    </div>\n    <div class=\"form-field\">\n      <label class=\"form-label\">Nome do escritório</label>\n      <input type=\"text\" class=\"form-input\" placeholder=\"Nome do escritório\">\n    </div>\n    <div class=\"form-field\">\n      <label class=\"form-label\">Telefone / WhatsApp</label>\n      <input type=\"tel\" class=\"form-input\" placeholder=\"(21) 00000-0000\">\n    </div>\n    <div class=\"form-field\">\n      <label class=\"form-label\">E-mail</label>\n      <input type=\"email\" class=\"form-input\" placeholder=\"seu@email.com\">\n    </div>\n    <div class=\"form-field\">\n      <label class=\"form-label\">Instagram</label>\n      <input type=\"text\" class=\"form-input\" placeholder=\"@seuinstagram\">\n    </div>\n    <div class=\"form-field\">\n      <label class=\"form-label\">Cidade / Bairro</label>\n      <input type=\"text\" class=\"form-input\" placeholder=\"Rio de Janeiro\">\n    </div>\n    <div class=\"form-field form-submit\">\n      <button type=\"submit\" class=\"btn-mustard\" style=\"width:100%;padding:18px;\">Enviar cadastro</button>\n    </div>\n  </form>\n</section>\n\n\n<!-- ══ CTA FINAL ══ -->\n"}}, {"type": "Secao", "props": {"id": "arquitetos-designers-sec-8", "rotulo": "cta-final", "html": "<section class=\"cta-final\">\n  <div class=\"eyebrow cta-final-eyebrow\" style=\"font-size: 14px;\">Agende uma visita</div>\n  <h2 class=\"cta-final-title\">Vamos até você</h2>\n  <p class=\"cta-final-sub\">Agende uma visita ao seu escritório e conheça nossos mostruários exclusivos.</p>\n  <div class=\"cta-final-btns\">\n    <a href=\"https://api.whatsapp.com/send?phone=5521999886842&amp;text=Olá, Casa Estampa! Quero agendar uma visita ao meu escritório para conhecer os mostruários.\" class=\"btn-mustard\">Agendar visita pelo WhatsApp</a>\n    <a href=\"#cadastro\" class=\"btn-ghost\">Fazer cadastro</a>\n  </div>\n</section>"}}], "root": {"props": {}}}